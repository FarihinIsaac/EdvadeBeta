# Copy to .env and fill in values. Never commit .env to git.

# Server
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASS=your_password
DB_NAME=edvade
# Set to true for cloud MySQL that requires SSL (Railway, PlanetScale, etc.)
DB_SSL=false

# Auth — use a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret

# CORS — comma-separated frontend URLs (no trailing slash)
# Local: http://127.0.0.1:5500,http://localhost:5500
FRONTEND_URL=

# Optional: serve edvadefrontend from this server (single-domain deploy)
SERVE_FRONTEND=false

# Seed script only (scripts/seed-lecturer.js)
LECTURER_EMAIL=lecturer@edvade.com
LECTURER_PASSWORD=lecturer123
LECTURER_NAME=Lecturer Admin
